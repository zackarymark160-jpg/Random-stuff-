export function levelOf(st: any) { if (st.prog === "ln") return "ln"; const b = +st.belt || 0; if (st.prog === "adult") return b >= 13 ? "bb" : "ad"; return b <= 3 ? "l1" : b <= 7 ? "l2" : b <= 12 ? (b >= 10 ? "bp" : "l3") : "bb"; }
export function kidClassesOn(st: any, day: number) { const lv = levelOf(st), mine = [lv]; if (lv === "bp") mine.push("l3"); if (lv === "l3") mine.push("bp"); return CLASSES.filter((c) => c.d === day && (mine.includes(c.lv) || (c.lv === "ad" && st.prog === "adult"))); }
